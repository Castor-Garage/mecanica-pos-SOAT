            {
              "name": "Delete (soft delete)",
              "request": {
                "method": "DELETE",
                "url": { "raw": "{{baseUrl}}/vehicles/{{vehicleId}}", "host": ["{{baseUrl}}"], "path": ["vehicles", "{{vehicleId}}"] }
              }
            }
          ]
        },
        {
          "name": "Services",
          "item": [
            {
              "name": "List",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/services?page=1&perPage=20&onlyActive=true",
                  "host": ["{{baseUrl}}"],
