{
  "info": {
    "name": "Castor Garage API",
    "description": "Collection completa da API da oficina mecânica (Tech Challenge Fase 2). Login em Auth > Login salva o token automaticamente em {{token}} para as demais requisições.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "castor-garage-api-collection"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:30080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "clientId", "value": "", "type": "string" },
    { "key": "vehicleId", "value": "", "type": "string" },
    { "key": "serviceId", "value": "", "type": "string" },
    { "key": "partId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "orderNumber", "value": "OS-2026-00003", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "OpenAPI JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/docs/json", "host": ["{{baseUrl}}"], "path": ["docs", "json"] },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('token salvo em {{token}}');",
                  "}",
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@oficina.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Service Orders",
      "item": [
        {
          "name": "Track by order number (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/service-orders/track/{{orderNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders", "track", "{{orderNumber}}"]
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "List (com ordenação por status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/service-orders?page=1&perPage=20",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "perPage", "value": "20" },
                { "key": "status", "value": "EM_EXECUCAO", "disabled": true },
                { "key": "clientId", "value": "{{clientId}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Stats (tempo médio por serviço)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/service-orders/stats", "host": ["{{baseUrl}}"], "path": ["service-orders", "stats"] }
          }
        },
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('orderId', json.id);",
                  "  console.log('orderId salvo:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"problemDescription\": \"Barulho estranho ao frear\",\n  \"services\": [\n    { \"serviceId\": \"{{serviceId}}\", \"quantity\": 1 }\n  ],\n  \"parts\": [\n    { \"partId\": \"{{partId}}\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/service-orders", "host": ["{{baseUrl}}"], "path": ["service-orders"] }
          }
        },
        {
          "name": "Get by id (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/service-orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders", "{{orderId}}"]
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Advance status",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Avançando etapa\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/service-orders/{{orderId}}/advance",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders", "{{orderId}}", "advance"]
            }
          }
        },
        {
          "name": "Approve budget",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/service-orders/{{orderId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders", "{{orderId}}", "approve"]
            }
          }
        },
        {
          "name": "Reject budget",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Cliente recusou o orçamento\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/service-orders/{{orderId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders", "{{orderId}}", "reject"]
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Email status update (aprovação/rejeição/avanço)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"APROVAR {{orderNumber}}\",\n  \"body\": \"Cliente aprova o orçamento\",\n  \"from\": \"cliente@email.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/webhooks/email", "host": ["{{baseUrl}}"], "path": ["webhooks", "email"] },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Cadastros",
      "item": [
        {
          "name": "Clients",
