# Connection string do banco gerenciado (RDS), a mesma base usada pela API
# principal. Ex.: postgresql://usuario:senha@host:5432/mecanica_db
DATABASE_URL=

# Mesmo valor configurado na API principal (k8s/secret.yaml) — o token so
# funciona nas rotas protegidas se o segredo for identico dos dois lados.
JWT_SECRET=

# Opcional. Padrao: 8h (mesmo padrao da API principal).
JWT_EXPIRES_IN=8h

# Opcional. Desliga TLS na conexao com o banco (uso local/teste). Em
# producao, com RDS, deixe sem definir.
DATABASE_SSL=

# Opcional. Origem liberada no header CORS da resposta. Padrao: *
CORS_ORIGIN=
