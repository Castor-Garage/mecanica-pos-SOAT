# Database
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/mecanica_db"

# Auth
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# Server
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
# Level of the JSON logs written outside development (default: info)
LOG_LEVEL="info"

# New Relic APM (observability). Leave NEW_RELIC_LICENSE_KEY empty to run with
# the agent disabled (no crash, just a startup log line) - only needed against
# a real New Relic account (staging/production).
NEW_RELIC_APP_NAME="mecanica-castor-garage"
NEW_RELIC_LICENSE_KEY=""
NEW_RELIC_AI_MONITORING_ENABLED=true
NEW_RELIC_CUSTOM_INSIGHTS_EVENTS_MAX_SAMPLES_STORED=100k
NEW_RELIC_SPAN_EVENTS_MAX_SAMPLES_STORED=10k

# New Relic Infrastructure Agent (Docker monitoring). Separate license key from
# NEW_RELIC_LICENSE_KEY above - used only by the newrelic-infra container.
NEW_RELIC_DOCKER=""

# Admin seed (used by prisma/seed.ts)
ADMIN_EMAIL="admin@oficina.com"
ADMIN_PASSWORD="Admin@123"

# SMTP (used to send OS data by e-mail from the public tracking page)
# Leave SMTP_USER empty to auto-use a disposable Ethereal test account (no signup,
# logs a preview URL in the server console). Set real values to send for real
# (Mailtrap, Gmail with an app password, etc.)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@oficina.com"
