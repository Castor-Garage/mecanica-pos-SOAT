                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Maria da Silva\",\n  \"document\": \"12345678909\",\n  \"documentType\": \"CPF\",\n  \"phone\": \"11999998888\",\n  \"email\": \"maria@email.com\",\n  \"address\": \"Rua das Flores, 123\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/clients", "host": ["{{baseUrl}}"], "path": ["clients"] }
              }
            },
            {
              "name": "Get by id",
              "request": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] }
              }
            },
            {
              "name": "Update",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"phone\": \"11988887777\"\n}" },
                "url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] }
              }
            },
            {
              "name": "Delete (soft delete)",
              "request": {
                "method": "DELETE",
                "url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] }
              }
            }
          ]
        },
        {
          "name": "Vehicles",
          "item": [
            {
              "name": "List",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/vehicles?page=1&perPage=20",
